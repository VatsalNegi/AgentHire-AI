# Set this at build time to the deployed FastAPI origin.
# Leave empty to use the local development fallback.
VITE_API_URL=

# Browser-safe Supabase project configuration.
# VITE_SUPABASE_ANON_KEY may contain the legacy anon JWT or a public sb_publishable_ key.
# Never use a service-role or secret key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
